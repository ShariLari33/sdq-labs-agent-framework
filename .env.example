# SDQ local development environment.
# Copy to .env and fill only what you need. Do not commit .env.

# SDQ API
DATABASE_URL=postgresql://sdq:sdq_dev_password@postgres:5432/sdq_agents
SDQ_ENVIRONMENT=development
SDQ_ALLOW_AUTO_APPROVALS=false
SDQ_ALLOW_AUTO_EVOLUTION=false
SDQ_ALLOW_SYNTHETIC_DATA=false

# LLM providers, optional for mock/local deterministic flows.
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_PROVIDER=mock

# Future internal integrations. Generate locally; do not reuse production values.
SDQ_INTERNAL_API_TOKEN=

# Paperclip operator token for local sandbox bootstrap only.
# Store real values in ignored local env files. Never commit tokens.
PAPERCLIP_API_BASE_URL=http://localhost:3100/api
PAPERCLIP_OPERATOR_API_TOKEN=

# Future reverse proxy / public URL placeholders.
PUBLIC_BASE_URL=http://localhost:8000
