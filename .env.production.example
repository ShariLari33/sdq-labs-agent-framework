# Production environment template.
# Copy to .env.production on the server and fill values from a password manager.
# Do not commit real production secrets.

# SDQ API
DATABASE_URL=postgresql://sdq:<strong-password>@sdq-postgres:5432/sdq_agents
PUBLIC_BASE_URL=https://api.example.com
SDQ_INTERNAL_API_TOKEN=<generate-with-openssl-rand-hex-32>

# SDQ PostgreSQL
POSTGRES_USER=sdq
POSTGRES_PASSWORD=<strong-password>
POSTGRES_DB=sdq_agents

# Paperclip
PAPERCLIP_PUBLIC_URL=https://paperclip.example.com
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
BETTER_AUTH_SECRET=<generate-with-openssl-rand-hex-32>
PAPERCLIP_POSTGRES_USER=paperclip
PAPERCLIP_POSTGRES_PASSWORD=<strong-password>
PAPERCLIP_POSTGRES_DB=paperclip

# LLM providers. Configure only when live model calls are intended.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=

# Reverse proxy / TLS
DOMAIN_NAME=example.com
ACME_EMAIL=ops@example.com
