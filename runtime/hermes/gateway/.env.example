# Local Hermes Gateway configuration. Copy to .env; do not commit .env.

# Official Hermes API server settings.
API_SERVER_KEY=
HERMES_GATEWAY_PORT=8642
HERMES_VERSION=0.18.2

# URLs inside Docker networks.
PAPERCLIP_API_URL=http://server:3100/api
SDQ_API_BASE_URL=http://api:8000

# Optional provider credentials. Leave empty until live model calls are intended.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
